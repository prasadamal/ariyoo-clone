# Copy to .env for local development. NEVER commit .env.
NODE_ENV=development
PORT=3333

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ariyoo?schema=public

# REQUIRED in production: >= 32 random chars. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (REST + Socket.IO). REQUIRED in production.
# Native mobile apps do not send an Origin header and are not affected by CORS.
CORS_ORIGINS=http://localhost:4200,http://localhost:8081,http://localhost:19006

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Set to the number of reverse-proxy hops in front of the API (e.g. 1 behind a load balancer)
# so rate limiting sees real client IPs. 0 = do not trust proxy headers.
TRUST_PROXY=0

# Rate limits (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
