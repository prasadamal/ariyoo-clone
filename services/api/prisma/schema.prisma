generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  fullName     String
  userName     String?   @unique
  isSeeker     Boolean   @default(true)
  isSolver     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  /// When the member accepted the Terms of Use (required to register).
  termsAcceptedAt DateTime?
  /// Set by a moderator; a suspended member cannot sign in or use the API.
  suspendedAt  DateTime?
  pushTokens   PushToken[]
  tags         UserTag[]
  places       UserPlace[]
  placeTags    UserPlaceTag[]
  seekerSessions Session[] @relation("SeekerSessions")
  solverSessions Session[] @relation("SolverSessions")
}

model Tag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users UserTag[]
}

model Place {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users UserPlace[]
}

model PlaceTag {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  users UserPlaceTag[]
}

model UserTag {
  userId Int
  tagId  Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id])
  @@id([userId, tagId])
}

model UserPlace {
  id      Int   @id @default(autoincrement())
  userId  Int
  placeId Int
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place   Place @relation(fields: [placeId], references: [id])
  @@unique([userId, placeId])
}

model UserPlaceTag {
  id         Int      @id @default(autoincrement())
  userId     Int
  placeTagId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeTag   PlaceTag @relation(fields: [placeTagId], references: [id])
  @@unique([userId, placeTagId])
}

model Session {
  id        Int      @id @default(autoincrement())
  seekerId  Int
  /// Null while the question waits in the open queue for an expert to pick it up.
  solverId  Int?
  title     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seeker    User     @relation("SeekerSessions", fields: [seekerId], references: [id])
  solver    User?    @relation("SolverSessions", fields: [solverId], references: [id])
  messages  Message[]

  @@index([seekerId])
  @@index([solverId])
}

model Message {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  senderId   Int
  messageText String?
  imageUrl   String?
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Newsletter {
  id    Int    @id @default(autoincrement())
  email String @unique
  createdAt DateTime @default(now())
}

/// One member hiding another. Blocks work both ways: neither can message the other.
model Block {
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// A report for the moderator. Ids are plain numbers so a report outlives a deleted account.
model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reportedId Int
  sessionId  Int?
  reason     String
  details    String?
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

model PushToken {
  token     String   @id
  userId    Int
  platform  String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
