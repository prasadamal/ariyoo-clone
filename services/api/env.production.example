DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ariyoo?schema=public
JWT_SECRET=generate_a_unique_random_value_of_32_chars_or_more
PORT=3333
# Point this at a persistent disk, or chat photos are lost on every redeploy.
UPLOAD_DIR=./uploads
# Random string, 24+ characters. Unlocks the moderation routes (see MODERATION.md).
ADMIN_API_KEY=
# Number of reverse proxies in front of the API (1 on Render, Railway and Fly).
TRUST_PROXY=1
# Optional extra words or phrases to refuse, comma-separated.
CONTENT_BLOCKLIST=

CORS_ORIGINS=https://your-web-app.example.com
