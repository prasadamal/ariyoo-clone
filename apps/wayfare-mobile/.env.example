# Copy to .env.local for local Expo dev (optional — the app works as an offline journal without these)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project id from `eas init`. Only `expo start` reads this file — for EAS builds paste the id into
# app.config.ts (see store/EAS_SECRETS.md).
EAS_PROJECT_ID=

# Optional: Google Maps tiles on Android (Maps SDK key in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public web viewers (GitHub Pages by default)
EXPO_PUBLIC_WAYFARE_SHARE_BASE=https://ariyoo-docs.onrender.com/wayfare-share/index.html
EXPO_PUBLIC_WAYFARE_LIVE_BASE=https://ariyoo-docs.onrender.com/wayfare-live/index.html

# Production builds: EAS environment variables (see store/EAS_SECRETS.md)
