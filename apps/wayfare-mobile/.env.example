# Copy to .env.local for local development. The app also runs fully offline without these.
# Both values are PUBLIC client keys (row-level security protects the data) and are already
# set for cloud builds in eas.json. Use them locally to talk to the hosted project:
EXPO_PUBLIC_SUPABASE_URL=https://ujtylwimukufmbungnju.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_QuNfyAkk9RGxLIreVX8xsw_SG73ky7q

# Written by `eas init` (or export it in CI)
EAS_PROJECT_ID=

# REQUIRED for the Route map on Android (Maps SDK for Android key from Google Cloud Console).
# Keep it out of git: eas secret:create --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value ... --scope project
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public read-only trip page (GitHub Pages)
EXPO_PUBLIC_WAYFARE_SHARE_BASE=https://prasadamal.github.io/ariyoo-clone/wayfare-share/index.html
