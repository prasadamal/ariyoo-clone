# Copy to .env.local for local Expo dev (optional — app works offline without these)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

EAS_PROJECT_ID=

# Optional: richer Google Maps on Android (Maps SDK key in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public share page base (GitHub Pages)
EXPO_PUBLIC_WAYFARE_SHARE_BASE=https://prasadamal.github.io/ariyoo-clone/wayfare-share/index.html

# Production: use EAS secrets
# eas secret:create --name EXPO_PUBLIC_SUPABASE_URL --value https://xxx.supabase.co --scope project
# eas secret:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value eyJ... --scope project
