# Copy to .env.local for local Expo dev
EXPO_PUBLIC_API_URL=http://localhost:5296

# Set after `eas init` (also in app.config.ts extra.eas.projectId)
EAS_PROJECT_ID=

# Production: prefer EAS secrets (do not commit real values)
# eas secret:create --name EXPO_PUBLIC_API_URL --value https://api.ariyoo.app --scope project
