# Copy to .env.local for local Expo development.
# Leave EXPO_PUBLIC_API_URL unset to use the API on this computer (port 5296).
# On a physical phone use your computer's LAN address, e.g. http://192.168.1.20:5296
EXPO_PUBLIC_API_URL=

# Project id from `eas init`. Only `expo start` reads this file — for EAS builds paste the id into
# app.config.ts (see store/EAS_SECRETS.md).
EAS_PROJECT_ID=

# Store builds: set EXPO_PUBLIC_API_URL as an EAS environment variable (store/EAS_SECRETS.md).
